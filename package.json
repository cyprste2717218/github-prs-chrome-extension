{
  "name": "github-prs-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "xo --prettier --clear-cache",
    "lint-fix": "xo src --fix --prettier",
    "pretty-format": "npx prettier . --write src/**/*.{js,jsx,ts,tsx}",
    "pretty-check": "npx prettier . --check src/**/*.{js,jsx,ts,tsx}",
    "run-pretty": "node src/utilities/scripts/runFormatter.js",
    "preview": "vite preview",
    "prepare": "husky",
    "build-browser-extension-container": "docker build -t cyprste2717218/browser-extension --file browser-extension.dockerfile .",
    "docker-build": "npm run build-browser-extension-container",
    "run-browser-extension-container": "docker run -it --init --cap-add=SYS_ADMIN --rm --name browser-extension cyprste2717218/browser-extension",
    "docker-run": "npm run run-browser-extension-container",
    "docker-setup": "npm run docker-build && npm run docker-run",
    "test": "npm run test:unit && npm run test:it && npm run test:end",
    "test:unit": "jest --testMatch \"**/*.unit.test.ts\"",
    "test:it": "jest --testMatch \"**/*.it.test.ts\"",
    "test:end": "jest --testMatch \"**/*.end.test.ts\""
  },
  "dependencies": {
    "@n8tb1t/use-scroll-position": "^2.0.3",
    "@octokit/core": "^6.1.2",
    "@octokit/request": "^9.2.1",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tailwindcss/vite": "^4.1.17",
    "chrome-types": "^0.1.301",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "fast-glob": "^3.3.2",
    "jest": "^30.2.0",
    "lucide-react": "^0.439.0",
    "puppeteer": "^24.29.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.9.0",
    "@jest/globals": "^30.2.0",
    "@types/body-parser": "^1.19.5",
    "@types/chrome": "^0.1.27",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^30.2.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "husky": "^9.1.5",
    "postcss": "^8.4.45",
    "prettier": "3.3.3",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.4.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^6.4.1",
    "xo": "^1.0.0"
  }
}
